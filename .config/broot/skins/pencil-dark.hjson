###############################################################
# Pencil Dark skin for broot
# Based on https://github.com/preservim/vim-colors-pencil
###############################################################
syntax_theme: base16-eighties.dark

skin: {
    input: rgb(241, 241, 241) none
    selected_line: none rgb(66, 66, 66)
    default: rgb(229, 230, 230) none
    tree: rgb(138, 138, 138) none
    parent: rgb(32, 187, 252) none
    file: none none

    perm__: rgb(138, 138, 138) none
    perm_r: rgb(243, 228, 48) none
    perm_w: rgb(227, 39, 145) none
    perm_x: rgb(95, 215, 167) none
    owner: rgb(79, 184, 204) none
    group: rgb(32, 165, 186) none

    dates: rgb(148, 148, 148) none

    directory: rgb(32, 187, 252) none Bold
    exe: rgb(95, 215, 167) none
    link: rgb(135, 117, 232) none
    pruning: rgb(148, 148, 148) none Italic

    preview_title: rgb(241, 241, 241) rgb(38, 38, 38)
    preview: rgb(229, 230, 230) rgb(38, 38, 38)
    preview_line_number: rgb(138, 138, 138) none
    preview_separator: rgb(84, 84, 84) none

    char_match: rgb(243, 228, 48) rgb(66, 66, 66) Bold Italic
    content_match: rgb(243, 228, 48) rgb(66, 66, 66) Bold Italic
    preview_match: rgb(243, 228, 48) rgb(66, 66, 66) Bold Italic

    count: rgb(243, 228, 48) none
    sparse: rgb(227, 39, 145) none
    content_extract: rgb(79, 184, 204) none Italic

    git_branch: rgb(135, 117, 232) none
    git_insertions: rgb(95, 215, 167) none
    git_deletions: rgb(227, 39, 145) none
    git_status_current: rgb(138, 138, 138) none
    git_status_modified: rgb(243, 228, 48) none
    git_status_new: rgb(95, 215, 167) none Bold
    git_status_ignored: rgb(138, 138, 138) none
    git_status_conflicted: rgb(251, 0, 122) none
    git_status_other: rgb(135, 117, 232) none
    staging_area_title: rgb(32, 187, 252) none

    flag_label: rgb(148, 148, 148) none
    flag_value: rgb(32, 187, 252) none Bold

    status_normal: rgb(229, 230, 230) rgb(38, 38, 38)
    status_italic: rgb(79, 184, 204) rgb(38, 38, 38) Italic
    status_bold: rgb(32, 187, 252) rgb(38, 38, 38) Bold
    status_ellipsis: rgb(148, 148, 148) rgb(38, 38, 38) Bold
    status_error: rgb(241, 241, 241) rgb(195, 7, 113)
    status_job: rgb(243, 228, 48) rgb(38, 38, 38)
    status_code: rgb(95, 215, 167) rgb(38, 38, 38) Italic
    mode_command_mark: rgb(33, 33, 33) rgb(32, 187, 252) Bold

    help_paragraph: rgb(229, 230, 230) none
    help_headers: rgb(32, 187, 252) none Bold
    help_bold: rgb(95, 215, 167) none Bold
    help_italic: rgb(79, 184, 204) none Italic
    help_code: rgb(95, 215, 167) rgb(48, 48, 48)
    help_table_border: rgb(84, 84, 84) none

    hex_null: rgb(138, 138, 138) none
    hex_ascii_graphic: rgb(229, 230, 230) none
    hex_ascii_whitespace: rgb(95, 215, 167) none
    hex_ascii_other: rgb(79, 184, 204) none
    hex_non_ascii: rgb(227, 39, 145) none

    file_error: rgb(251, 0, 122) none

    purpose_normal: none none
    purpose_italic: rgb(135, 117, 232) none Italic
    purpose_bold: rgb(135, 117, 232) none Bold
    purpose_ellipsis: none none

    scrollbar_track: rgb(48, 48, 48) none
    scrollbar_thumb: rgb(138, 138, 138) none

    good_to_bad_0: rgb(95, 215, 167) none
    good_to_bad_1: rgb(16, 167, 120) none
    good_to_bad_2: rgb(79, 184, 204) none
    good_to_bad_3: rgb(32, 165, 186) none
    good_to_bad_4: rgb(32, 187, 252) none
    good_to_bad_5: rgb(0, 142, 196) none
    good_to_bad_6: rgb(243, 228, 48) none
    good_to_bad_7: rgb(168, 156, 20) none
    good_to_bad_8: rgb(227, 39, 145) none
    good_to_bad_9: rgb(251, 0, 122) none
}
