###############################################################
# Pencil Light skin for broot
# Based on https://github.com/preservim/vim-colors-pencil
###############################################################
syntax_theme: base16-ocean.light

skin: {
    input: rgb(66, 66, 66) none
    selected_line: none rgb(182, 214, 253)
    default: rgb(66, 66, 66) none
    tree: rgb(138, 138, 138) none
    parent: rgb(0, 108, 150) none
    file: none none

    perm__: rgb(95, 95, 95) none
    perm_r: rgb(125, 115, 12) none
    perm_w: rgb(195, 7, 113) none
    perm_x: rgb(11, 122, 87) none
    owner: rgb(20, 120, 136) none
    group: rgb(0, 95, 135) none

    dates: rgb(95, 95, 95) none

    directory: rgb(0, 108, 150) none Bold
    exe: rgb(11, 122, 87) none
    link: rgb(82, 60, 121) none
    pruning: rgb(95, 95, 95) none Italic

    preview_title: rgb(66, 66, 66) rgb(229, 230, 230)
    preview: rgb(66, 66, 66) rgb(229, 230, 230)
    preview_line_number: rgb(95, 95, 95) none
    preview_separator: rgb(217, 217, 217) none

    char_match: rgb(33, 33, 33) rgb(243, 228, 48) Bold Italic
    content_match: rgb(33, 33, 33) rgb(243, 228, 48) Bold Italic
    preview_match: rgb(33, 33, 33) rgb(243, 228, 48) Bold Italic

    count: rgb(125, 115, 12) none
    sparse: rgb(195, 7, 113) none
    content_extract: rgb(20, 120, 136) none Italic

    git_branch: rgb(82, 60, 121) none
    git_insertions: rgb(11, 122, 87) none
    git_deletions: rgb(195, 7, 113) none
    git_status_current: rgb(95, 95, 95) none
    git_status_modified: rgb(125, 115, 12) none
    git_status_new: rgb(11, 122, 87) none Bold
    git_status_ignored: rgb(138, 138, 138) none
    git_status_conflicted: rgb(195, 7, 113) none
    git_status_other: rgb(82, 60, 121) none
    staging_area_title: rgb(0, 108, 150) none

    flag_label: rgb(95, 95, 95) none
    flag_value: rgb(0, 108, 150) none Bold

    status_normal: rgb(66, 66, 66) rgb(229, 230, 230)
    status_italic: rgb(20, 120, 136) rgb(229, 230, 230) Italic
    status_bold: rgb(0, 108, 150) rgb(229, 230, 230) Bold
    status_ellipsis: rgb(95, 95, 95) rgb(229, 230, 230) Bold
    status_error: rgb(241, 241, 241) rgb(195, 7, 113)
    status_job: rgb(125, 115, 12) rgb(229, 230, 230)
    status_code: rgb(11, 122, 87) rgb(229, 230, 230) Italic
    mode_command_mark: rgb(241, 241, 241) rgb(0, 108, 150) Bold

    help_paragraph: rgb(66, 66, 66) none
    help_headers: rgb(0, 108, 150) none Bold
    help_bold: rgb(11, 122, 87) none Bold
    help_italic: rgb(20, 120, 136) none Italic
    help_code: rgb(11, 122, 87) rgb(217, 217, 217)
    help_table_border: rgb(217, 217, 217) none

    hex_null: rgb(138, 138, 138) none
    hex_ascii_graphic: rgb(66, 66, 66) none
    hex_ascii_whitespace: rgb(11, 122, 87) none
    hex_ascii_other: rgb(20, 120, 136) none
    hex_non_ascii: rgb(195, 7, 113) none

    file_error: rgb(195, 7, 113) none

    purpose_normal: none none
    purpose_italic: rgb(82, 60, 121) none Italic
    purpose_bold: rgb(82, 60, 121) none Bold
    purpose_ellipsis: none none

    scrollbar_track: rgb(217, 217, 217) none
    scrollbar_thumb: rgb(138, 138, 138) none

    good_to_bad_0: rgb(11, 122, 87) none
    good_to_bad_1: rgb(16, 167, 120) none
    good_to_bad_2: rgb(20, 120, 136) none
    good_to_bad_3: rgb(32, 165, 186) none
    good_to_bad_4: rgb(0, 108, 150) none
    good_to_bad_5: rgb(0, 142, 196) none
    good_to_bad_6: rgb(125, 115, 12) none
    good_to_bad_7: rgb(168, 156, 20) none
    good_to_bad_8: rgb(195, 7, 113) none
    good_to_bad_9: rgb(227, 39, 145) none
}
