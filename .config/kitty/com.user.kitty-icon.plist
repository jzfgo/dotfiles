<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.kitty-icon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Redirect logs here because launchd does not expand $HOME in path keys -->
        <string>mkdir -p "$HOME/Library/Logs" &amp;&amp; exec /bin/bash "$HOME/.config/kitty/set-kitty-icon.sh" --watch >> "$HOME/Library/Logs/kitty-icon.log" 2>&amp;1</string>
    </array>

    <!-- Watch /Applications (not kitty.app directly): launchd loses the WatchPaths
         vnode watch when kitty.app is deleted and recreated during brew upgrade,
         because the old inode is unlinked. The parent directory inode is stable. -->
    <key>WatchPaths</key>
    <array>
        <string>/Applications</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
