<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.kitty-icon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec "$HOME/.config/kitty/set-kitty-icon.sh"</string>
    </array>

    <!-- Fire when the kitty app bundle is replaced (e.g. after brew upgrade kitty) -->
    <key>WatchPaths</key>
    <array>
        <string>/Applications/kitty.app</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/kitty-icon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/kitty-icon-error.log</string>
</dict>
</plist>
