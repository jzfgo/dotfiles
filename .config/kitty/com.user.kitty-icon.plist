<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.kitty-icon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Redirect logs here because launchd does not expand $HOME in path keys -->
        <string>exec "$HOME/.config/kitty/set-kitty-icon.sh" >> "$HOME/Library/Logs/kitty-icon.log" 2>&amp;1</string>
    </array>

    <!-- Fire when the kitty app bundle is replaced (e.g. after brew upgrade kitty) -->
    <key>WatchPaths</key>
    <array>
        <string>/Applications/kitty.app</string>
    </array>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
